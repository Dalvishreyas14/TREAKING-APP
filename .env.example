# ---------------------------------------------------------------------------
# LIFEOS - environment template
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Used by the Prisma CLI and the runtime client.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lifeos?schema=public"

# Auth.js signing secret. Required.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# Canonical app URL. Used to build verification and password-reset links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32-byte base64url key used to encrypt OAuth tokens for calendar connections.
TOKEN_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# AI provider: local | openai | anthropic | google
# `local` is a deterministic engine and needs no API key.
# Keys below are read server-side only.
# ---------------------------------------------------------------------------
AI_PROVIDER="local"
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_GENERATIVE_AI_API_KEY=""

# Google OAuth. Both required to enable "Continue with Google".
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Email: dev | resend
# `dev` writes messages to ./.dev-mail/ and logs the links.
# ---------------------------------------------------------------------------
EMAIL_TRANSPORT="dev"
# RESEND_API_KEY=""
# EMAIL_FROM="LIFEOS <noreply@example.com>"
