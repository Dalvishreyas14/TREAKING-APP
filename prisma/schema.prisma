// LIFEOS - Prisma schema
//
// Prisma 7 notes (these are load-bearing, do not "simplify" them):
//   * generator provider is "prisma-client" (not prisma-client-js) and REQUIRES an explicit output path.
//   * the datasource block must NOT declare `url` - the connection string lives in prisma.config.ts.
//   * enum values intentionally carry no @map. Prisma 7 generates TS enums from mapped values
//     while the engine still expects schema names, which breaks at runtime (prisma/orm#28591).
//
// Index strategy: every user-owned table is indexed on (userId, ...) because every query in the
// application is scoped to a single user. Authorization is enforced in the service layer, so these
// indexes are load-bearing for both correctness (no cross-user scans) and performance.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum CategoryKind {
  HEALTH
  FITNESS
  STUDY
  CAREER
  FINANCE
  RELATIONSHIPS
  PERSONAL_GROWTH
  REST
  HOBBIES
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EnergyCost {
  LOW
  MEDIUM
  HIGH
}

enum HabitType {
  BOOLEAN
  COUNT
  DURATION
  DISTANCE
  QUANTITY
}

enum HabitDifficulty {
  EASY
  MEDIUM
  HARD
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum GoalHorizon {
  SHORT
  MEDIUM
  LONG
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ABANDONED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum RoutineKind {
  MORNING
  STUDY
  WORKOUT
  EVENING
  NIGHT
  WORK
  COLLEGE
  CUSTOM
}

enum BlockSource {
  AI
  MANUAL
  ROUTINE
  CALENDAR
  FOCUS
}

enum FocusType {
  POMODORO
  CUSTOM
  DEEP_WORK
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  ARMS
  CORE
  LEGS
  GLUTES
  FULL_BODY
  CARDIO
  OTHER
}

/**
 * The lifecycle of a workout.
 * The PLANNED vs COMPLETED distinction is load-bearing: a PLANNED workout must
 * never be counted as training volume or completed sessions, so every aggregate
 * query filters on this rather than treating "a Workout row exists" as "it was
 * done".
 * The weekly planner adds three states to that pair, because "I did not do the
 * session I planned" has more than one honest shape:
 * - IN_PROGRESS is a session the user has started but not yet finished. It is
 * still not history, so it counts the same as PLANNED for every completed
 * figure, but the UI can show it as live.
 * - SKIPPED is a deliberate no-show. It is terminal and, importantly, distinct
 * from deleting: "I skipped Wednesday" is a fact about adherence, whereas a
 * deleted row is a plan that never existed.
 * - RESCHEDULED is terminal, recorded on the *original* slot when a session is
 * moved. The moved copy is a fresh PLANNED row, so the original keeps its
 * date and the history shows that the slot was not simply dropped.
 * Only COMPLETED counts as done. Every other value is explicitly not-done.
 */
enum WorkoutStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  RESCHEDULED
}

enum InsightKind {
  CORRELATION
  PATTERN
  PREDICTION
  RECOMMENDATION
  OBSERVATION
}

enum InsightStatus {
  NEW
  SEEN
  APPLIED
  DISMISSED
}

enum AISource {
  LOCAL
  LLM
}

enum NotificationType {
  TASK
  HABIT
  GOAL
  AI
  SYSTEM
  ACHIEVEMENT
}

enum ReminderChannel {
  IN_APP
  EMAIL
  PUSH
}

enum ReminderTargetType {
  TASK
  HABIT
  GOAL
  REVIEW
  CUSTOM
}

/**
 * What a weekly plan is about. Deliberately its own enum rather than a reuse of
 * `CategoryKind`: a plan's category is how the plan is *displayed and measured*
 * ("count my gym sessions"), which is a different question from which category a
 * task is filed under. Keeping them separate means a GATE prep plan can be STUDY
 * while the task it holds is filed under CAREER.
 */
enum WeeklyPlanCategory {
  STUDY
  FITNESS
  PERSONAL
  WORK
  PROJECT
  CUSTOM
}

/**
 * Which quantity the plan's target is denominated in.
 * `HOURS` is the honest default because it is the one measure that is genuinely
 * available: focus sessions carry `actualSeconds`. `SESSIONS` exists for plans
 * like a five-day gym week, where the meaningful count is completed habit logs
 * rather than minutes. `CUSTOM` is for a plan measured in pages, reps or
 * anything else - it carries no automatic measurement at all, which the UI says
 * out loud rather than reporting a meaningless percentage.
 */
enum WeeklyPlanTargetType {
  HOURS
  SESSIONS
  TASKS
  COUNT
}

enum WeeklyPlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CalendarSource {
  LOCAL
  GOOGLE
  OUTLOOK
}

/**
 * How often a study series repeats.
 * `NONE` is deliberately a member of the enum rather than the absence of a
 * series. A one-off session and a recurring series need the same editing,
 * rescheduling and history semantics, and modelling "does not repeat" as "no
 * series row" would mean every read path had to branch on whether the relation
 * happened to be null before it could say anything at all.
 */
enum StudyRepeat {
  NONE
  WEEKLY
  CUSTOM
}

/**
 * The lifecycle of a scheduled study session.
 * The distinction that matters is the same one the fitness log makes: a session
 * that was *planned* is not a session that was *done*. `PLANNED` covers both
 * sessions still in the future and sessions whose slot has passed untouched -
 * the UI tells those two apart by looking at the clock, not by inventing a
 * fifth stored state that would have to be written by a background job nobody
 * runs. `MISSED` is therefore recorded only when the user says so.
 * `RESCHEDULED` is terminal and sits on the *original* slot when a session is
 * moved; the moved copy is a fresh `PLANNED` row, so the week can say "moved
 * here from Tuesday" and the history keeps the fact that Tuesday was given up.
 */
enum StudySessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MISSED
  RESCHEDULED
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ---------------------------------------------------------------------------
// Auth + identity
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  role          UserRole  @default(USER)

  onboardedAt       DateTime?
  /**
   * When the password was last set. Compared against the `pwd` claim on the
   * session JWT so a password reset invalidates already-issued sessions.
   * With the JWT strategy there are no Session rows to delete, so this column
   * is the only thing that makes a reset actually terminate access.
   */
  passwordChangedAt DateTime?
  theme             ThemePreference @default(SYSTEM)
  timezone          String          @default("UTC")
  locale            String          @default("en")

  // User-controlled AI settings. aiConsentAt gates any use of an external LLM provider.
  aiEnabled        Boolean   @default(true)
  aiConsentAt      DateTime?
  gamificationOn   Boolean   @default(true)
  weekStartsOn     Int       @default(1)
  dailySummaryTime Int       @default(20)
  quietHoursStart  Int       @default(22)
  quietHoursEnd    Int       @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile             Profile?
  accounts            Account[]
  sessions            Session[]
  passwordResets      PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]
  categories          Category[]
  tags                Tag[]
  tasks               Task[]
  habits              Habit[]
  habitLogs           HabitLog[]
  goals               Goal[]
  projects            Project[]
  projectLinks        ProjectTask[]
  routines            Routine[]
  routineRuns         RoutineRun[]
  timeBlocks          TimeBlock[]
  focusSessions       FocusSession[]
  journalEntries      JournalEntry[]
  wellbeingEntries    MoodEnergyEntry[]
  insights            Insight[]
  weeklyReviews       WeeklyReview[]
  monthlyReports      MonthlyReport[]
  conversations       AIConversation[]
  messages            AIMessage[]
  stats               UserStats?
  achievements        UserAchievement[]
  notifications       Notification[]
  reminders           Reminder[]
  calendarEvents      CalendarEvent[]
  calendarConnections CalendarConnection[]
  weeklyPlans         WeeklyPlan[]
  weeklyPlanTemplates WeeklyPlanTemplate[]
  exercises           Exercise[]
  workouts            Workout[]
  workoutRoutines     WorkoutRoutine[]
  studySeries         StudySeries[]
  studySessions       StudySession[]

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * Email verification uses the same opaque-token design as PasswordResetToken:
 * only a SHA-256 digest is stored, so a database leak yields no usable links.
 * The Auth.js `VerificationToken` model is intentionally left to the adapter
 * for OAuth; our own flows do not use it.
 */
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Onboarding profile
// ---------------------------------------------------------------------------

model Profile {
  id     String @id @default(cuid())
  userId String @unique

  ageRange                String?
  occupation              String?
  wakeMinutes             Int? // minutes from midnight
  sleepMinutes            Int? // minutes from midnight
  availableWeekdayMinutes Int?
  availableWeekendMinutes Int?
  studyTargetMinutes      Int?
  fitnessFrequency        Int? // sessions per week
  productivityStyle       String?
  focusPreference         String?
  workLabel               String?
  workStartMinutes        Int?
  workEndMinutes          Int?
  workDays                Int[]    @default([])
  collegeLabel            String?
  collegeStartMinutes     Int?
  collegeEndMinutes       Int?
  collegeDays             Int[]    @default([])
  importantHabits         String[] @default([])
  goalsSummary            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id        String       @id @default(cuid())
  userId    String? // null => system category shared by every user
  name      String
  slug      String
  kind      CategoryKind @default(OTHER)
  weight    Float        @default(1.0)
  color     String       @default("#C8F751")
  icon      String       @default("circle")
  isSystem  Boolean      @default(false)
  sortOrder Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]
  habits        Habit[]
  goals         Goal[]
  routineItems  RoutineItem[]
  workouts      Workout[]
  studySeries   StudySeries[]
  studySessions StudySession[]

  @@unique([userId, slug])
  @@index([kind])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String
  slug   String
  color  String @default("#7C6BFF")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks TaskTag[]

  @@unique([userId, slug])
  @@index([userId])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Tasks (subtasks are tasks with a parentId)
// ---------------------------------------------------------------------------

model Task {
  id     String @id @default(cuid())
  userId String

  title    String
  notes    String?
  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)
  energy   EnergyCost   @default(MEDIUM)

  // 1-5 sliders the user can set directly. priorityScore is derived by the
  // priority engine and cached so list sorting stays a single indexed read.
  importance    Int    @default(3)
  urgency       Int    @default(3)
  priorityScore Float  @default(0)
  priorityBand  String @default("WHEN_FREE")

  startAt          DateTime?
  dueAt            DateTime?
  completedAt      DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  snoozedUntil     DateTime?

  isRecurring Boolean @default(false)
  recurrence  Json?

  reminderLeadMinutes Int?
  sortOrder           Int  @default(0)

  categoryId      String?
  goalId          String?
  parentId        String?
  goalMilestoneId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goal            Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  goalMilestone   GoalMilestone?   @relation(fields: [goalMilestoneId], references: [id], onDelete: SetNull)
  parent          Task?            @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks        Task[]           @relation("TaskSubtasks")
  routineItems    RoutineItem[]
  tags            TaskTag[]
  projectLinks    ProjectTask[]
  weeklyPlanLinks WeeklyPlanTask[]
  timeBlocks      TimeBlock[]
  focusSessions   FocusSession[]

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([userId, startAt])
  @@index([userId, priorityScore])
  @@index([goalId])
  @@index([parentId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  userId      String
  goalId      String? // the goal this project serves; a project can also stand alone
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  color       String        @default("#7C6BFF")
  icon        String        @default("folder")
  startAt     DateTime?
  dueAt       DateTime?
  completedAt DateTime?
  sortOrder   Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal?              @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks         ProjectTask[]
  milestones    ProjectMilestone[]
  focusSessions FocusSession[]
  weeklyPlans   WeeklyPlan[]

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([goalId])
}

model ProjectTask {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  taskId      String
  milestoneId String?
  sortOrder   Int      @default(0)
  addedAt     DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@unique([projectId, taskId])
  @@index([userId, projectId, sortOrder])
  @@index([taskId])
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  detail      String?
  dueAt       DateTime?
  status      MilestoneStatus @default(PENDING)
  sortOrder   Int             @default(0)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@index([projectId, sortOrder])
}

// ---------------------------------------------------------------------------
// Habits
// ---------------------------------------------------------------------------

model Habit {
  id     String @id @default(cuid())
  userId String

  name        String
  description String?
  icon        String          @default("target")
  color       String          @default("#C8F751")
  type        HabitType       @default(BOOLEAN)
  difficulty  HabitDifficulty @default(MEDIUM)
  frequency   HabitFrequency  @default(DAILY)

  unit           String? // pages, km, ml, min, sessions
  targetValue    Float   @default(1)
  targetMinutes  Int?
  timesPerPeriod Int? // for WEEKLY frequency

  preferredMinutes Int?
  reminderEnabled  Boolean @default(false)
  reminderMinutes  Int?

  startDate  DateTime
  endDate    DateTime?
  archivedAt DateTime?
  isActive   Boolean   @default(true)

  categoryId String?
  goalId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goal            Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  schedule        HabitSchedule[]
  logs            HabitLog[]
  routineItems    RoutineItem[]
  timeBlocks      TimeBlock[]
  weeklyPlanLinks WeeklyPlanHabit[]
  /**
   * Workouts that contribute to this habit. Completing such a workout logs the
   * habit for the day, so a live training session can keep a "Gym" streak alive
   * without the user logging the same effort twice by hand.
   */
  workouts        Workout[]
  /**
   * Study sessions that feed this habit. A scheduled session can log the habit
   * when it is finished, but only under the habit's own completion rules - the
   * session never decides on its own that the habit is done.
   */
  studySeries     StudySeries[]
  studySessions   StudySession[]

  @@index([userId, isActive])
  @@index([userId, startDate])
  @@index([categoryId])
}

model HabitSchedule {
  id        String @id @default(cuid())
  habitId   String
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, dayOfWeek])
  @@index([habitId])
}

model HabitLog {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  date      DateTime @db.Date
  value     Float    @default(0)
  completed Boolean  @default(false)
  note      String?

  /**
   * The workout that auto-logged this row, when one did.
   * Nullable and SetNull, and it is the double-count guard. When completing a
   * workout that is linked to a habit, the app writes a habit log so the streak
   * and dashboard see the session; the fitness page's "minutes trained" figure
   * then excludes any habit log carrying a `workoutId`, because the workout's
   * own `minutes` already represents that session. A log the user wrote by hand
   * has this null and still counts as its own activity.
   */
  workoutId String?

  /**
   * The scheduled study session that auto-logged this row, when one did.
   * The same double-count guard as `workoutId`, for the same reason: a
   * timetable session that feeds a habit writes the habit log so the streak and
   * the dashboard see the work, and the study page's own "minutes focused"
   * figure then excludes any log carrying a `studySessionId`, because the
   * session's own `actualMinutes` already represents that time.
   * It is also what makes finishing a session idempotent. Without it, finishing
   * the same session twice would write two logs and the habit would be credited
   * twice for one evening's work.
   */
  studySessionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit        Habit         @relation(fields: [habitId], references: [id], onDelete: Cascade)
  workout      Workout?      @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  studySession StudySession? @relation(fields: [studySessionId], references: [id], onDelete: SetNull)

  @@unique([habitId, date])
  @@index([userId, date])
  @@index([userId, completed])
  @@index([workoutId])
  @@index([studySessionId])
}

// ---------------------------------------------------------------------------
// Goals
// ---------------------------------------------------------------------------

model Goal {
  id     String @id @default(cuid())
  userId String

  title       String
  description String?
  status      GoalStatus  @default(ACTIVE)
  horizon     GoalHorizon @default(MEDIUM)
  color       String      @default("#7C6BFF")
  icon        String      @default("target")

  startDate     DateTime?
  targetDate    DateTime?
  achievedAt    DateTime?
  progress      Float     @default(0)
  xpReward      Int       @default(100)
  isAiGenerated Boolean   @default(false)
  sourceGoalId  String? // set when this goal was produced by goal breakdown

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  milestones  GoalMilestone[]
  checkIns    GoalCheckIn[]
  tasks       Task[]
  habits      Habit[]
  projects    Project[]
  weeklyPlans WeeklyPlan[]
  workouts    Workout[]

  @@index([userId, status])
  @@index([userId, targetDate])
}

model GoalMilestone {
  id          String          @id @default(cuid())
  goalId      String
  title       String
  detail      String?
  targetDate  DateTime?
  status      MilestoneStatus @default(PENDING)
  progress    Float           @default(0)
  sortOrder   Int             @default(0)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal  Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([goalId, sortOrder])
}

model GoalCheckIn {
  id        String   @id @default(cuid())
  goalId    String
  note      String?
  progress  Float    @default(0)
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

// ---------------------------------------------------------------------------
// Weekly plans
// ---------------------------------------------------------------------------

/**
 * A plan is an intention scoped to seven days, and the *only* thing it adds to the
 * existing model is that span.
 * Goals, Tasks, Habits and TimeBlocks already existed and already work. What none
 * of them could express was "this set of tasks is what I intend to do *this
 * week*", which is the unit a person actually reviews on a Sunday. So a plan owns
 * links and dates; it never owns copies of the work itself. Deleting a plan must
 * never delete a task the user also has on their task list, which is why
 * `WeeklyPlanTask` is a join and not a copy.
 * `startDate`/`endDate` are `@db.Date` UTC midnight, matching `TimeBlock.date`,
 * `HabitLog.date` and `WeeklyReview.weekStart`. A plan is a seven-day window but
 * the columns are not constrained to seven: a user planning a fortnight should be
 * able to say so, and the arithmetic that reads them works either way.
 */
model WeeklyPlan {
  id     String @id @default(cuid())
  userId String

  name        String
  description String?
  category    WeeklyPlanCategory @default(CUSTOM)

  /**
   * What the target is measured in, and what "actual" is therefore counted
   * against.
   * `HOURS` sums `FocusSession.actualSeconds`. `TASKS` counts completed linked
   * tasks. `COUNT` is user-reported and carries no automatic measurement at all.
   * `SESSIONS` is the one target whose source depends on `category`, because
   * "session" is not one thing. A fitness week's sessions are completed `HabitLog`
   * rows on its linked habits, matching how `fitness/page.tsx` already counts. A
   * study week's sessions are ended `FocusSession` rows on its linked tasks,
   * matching how `study/page.tsx` already counts. Neither number describes the
   * other, so `category` selects the source rather than one default applying to
   * every plan. `SESSIONS` is offered only for FITNESS and STUDY; on any other
   * category it reports itself unmeasurable rather than inventing a figure.
   */
  targetType  WeeklyPlanTargetType @default(HOURS)
  targetValue Float

  /**
   * The user's own progress figure, used only by a `COUNT` plan.
   * Nullable rather than defaulted to 0 on purpose: 0 is a claim ("you have done
   * none of this") and null is an admission ("I have not counted yet"). The
   * progress function treats them differently, because a plan nobody has got to
   * yet should not read as a plan that failed.
   * Only ever read when `targetType` is `COUNT`. The other three target types are
   * measured from `FocusSession`, `HabitLog` and `Task`, all of which are written
   * by shipped code paths, so a number stored here would be a second source of
   * truth competing with real data.
   */
  manualActual Float?

  status WeeklyPlanStatus @default(ACTIVE)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  // Both optional and both SetNull. A goal or project deleted underneath a plan
  // should leave the plan standing - the work was still intended, it just lost its
  // parent - rather than taking the user's week down with it.
  goalId    String?
  projectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal    Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks   WeeklyPlanTask[]
  habits  WeeklyPlanHabit[]
  days    WeeklyPlanDay[]

  @@index([userId, startDate])
  @@index([userId, status])
  @@index([goalId])
  @@index([projectId])
}

/**
 * Join row, composite-PK style, mirroring `ProjectTask`.
 * A task can sit in several plans across different weeks without contradiction -
 * "Revise chapter 4" is plausibly next week's job too. That is why this is not
 * unique on `taskId` alone, and it is also why copy-to-next-week cannot simply
 * reuse the same rows: completion is a fact about the task, not about its
 * presence in a plan, so a copied week has to get new tasks.
 */
model WeeklyPlanTask {
  weeklyPlanId String
  taskId       String
  sortOrder    Int    @default(0)

  /**
   * Which weekday this task is intended for: 0 = Sunday .. 6 = Saturday, matching
   * `Date.getDay()` and the same convention as `WeeklyPlanDay.dayOfWeek`.
   * Nullable on purpose. A task that belongs to the week without being pinned to a
   * particular day is a real state — "finish the chapter, whenever it fits" — and
   * forcing a day would invent a commitment the user never made. Rows written before
   * this column existed read null and are shown in an unscheduled strip rather than
   * being backfilled with a guess dressed up as a fact.
   * Intentionally *not* part of the composite key: the same task can be pinned to a
   * day in one plan and left floating in another without contradiction, exactly as it
   * can appear in several plans' weeks.
   */
  dayOfWeek Int?

  addedAt DateTime @default(now())

  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([weeklyPlanId, taskId])
  @@index([taskId])
}

/**
 * Fitness and study plans link *existing* habits rather than inventing their own.
 * This is why there is no `StudySession` table in this schema. `study/page.tsx`
 * is a lens over habits filtered by `Category.kind`. Fitness gained its own
 * `Workout` table once structured sessions (exercises, sets, reps, weight) turned
 * out to be more than a habit row could hold, but a fitness plan still counts the
 * logs on its linked habits, and a workout that targets a habit writes the log
 * rather than the plan reaching into the workout. A plan pointed at "Gym" counts
 * the logs on that habit.
 */
model WeeklyPlanHabit {
  weeklyPlanId String
  habitId      String
  addedAt      DateTime @default(now())

  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  habit      Habit      @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([weeklyPlanId, habitId])
  @@index([habitId])
}

/**
 * What the plan intends on each weekday, including the days it intends to rest.
 * This table exists for the rest days. "Wednesday: Rest" and "Sunday: Recovery"
 * are real content in a five-day gym plan, and absence cannot represent them: a
 * plan with rows for Mon/Tue/Thu/Sat is indistinguishable from one where the user
 * simply forgot Wednesday. An absent row means "nothing recorded", which is a
 * different and honest claim.
 */
model WeeklyPlanDay {
  id           String  @id @default(cuid())
  weeklyPlanId String
  /**
   * 0 = Sunday .. 6 = Saturday, matching `Date.getDay()` and JS convention.
   */
  dayOfWeek    Int
  note         String?

  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  @@unique([weeklyPlanId, dayOfWeek])
  @@index([weeklyPlanId])
}

/**
 * A reusable plan shape.
 * `configuration` holds per-day task *titles* and nothing else - no task ids, no
 * habit ids. That is the whole design constraint. A template that remembered which
 * tasks it pointed at would rot silently the first time a task was deleted, and
 * the failure would surface as a template that quietly applies one fewer task than
 * it shows. Titles cannot rot, so applying a template always produces exactly what
 * the template depicts.
 */
model WeeklyPlanTemplate {
  id     String @id @default(cuid())
  userId String

  name          String
  category      WeeklyPlanCategory @default(CUSTOM)
  configuration Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Study timetable
// ---------------------------------------------------------------------------

/**
 * The recurring rule behind a study session.
 * A series is the *plan*: one subject, one time of day, and the set of weekdays
 * it happens on. It is kept apart from the sessions it produces for the same
 * reason `WorkoutRoutine` is kept apart from `Workout` - a template that
 * remembered its own history would rot the first time a session was skipped or
 * completed, and the failure would surface as a timetable that quietly shows
 * one more session than the user actually did.
 * So the rule lives here and the occurrences live in `StudySession`. Editing a
 * series rewrites the future occurrences it owns; editing one occurrence
 * detaches it from the series for that day alone. Completed sessions are never
 * rewritten by either.
 */
model StudySeries {
  id     String @id @default(cuid())
  userId String

  title   String
  subject String
  notes   String?
  color   String  @default("#C8F751")

  /**
   * `NONE` is not a value a series is normally created with - a one-off session
   * is a plain `StudySession` with no series - but the enum carries it so a
   * series can be paused into "does not repeat any more" without the row
   * becoming meaningless.
   */
  repeat StudyRepeat @default(WEEKLY)

  /**
   * The weekdays this series happens on, as JS day indices: 0 = Sunday ..
   * 6 = Saturday.
   * Matches `HabitSchedule.dayOfWeek`, `WeeklyPlanDay.dayOfWeek` and
   * `WeeklyPlanTask.dayOfWeek`, all of which use the JS convention. The study
   * timetable links to habits and to weekly plans, and a table that disagreed
   * with its three neighbours about what "Monday" means would be a permanent
   * source of off-by-one bugs. `WorkoutRoutineDay.weekday` disagrees, and that
   * is a separate feature with its own constant to read.
   * `WEEKLY` series carry exactly one day here; `CUSTOM` series carry any
   * number. The array is the single source of truth in both cases - `repeat`
   * only decides how the UI describes it.
   */
  daysOfWeek Int[] @default([])

  /**
   * Minutes from local midnight. Local wall-clock rather than an instant,
   * because a session belongs to a slot on the user's own clock and the whole
   * point of "Monday 7pm" is that it stays 7pm.
   */
  startMinutes    Int
  durationMinutes Int

  reminderLeadMinutes Int?

  /**
   * The habit this session feeds, if any. Completing the session writes a log
   * against that habit under the habit's own completion rules - it never
   * invents one. `StudySession.habitId` copies this so a series edit can move
   * the link without rewriting history.
   */
  habitId    String?
  categoryId String?

  isActive Boolean @default(true)

  /**
   * The last day this series has had sessions materialised for.
   * The same rolling-horizon trick `WorkoutRoutine.generatedThrough` uses: only
   * days after this one are ever filled, so a session the user deleted is not
   * silently recreated the next time the page loads.
   */
  generatedThrough DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit    Habit?            @relation(fields: [habitId], references: [id], onDelete: SetNull)
  category Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sessions StudySession[]
  skips    StudySeriesSkip[]

  @@index([userId, isActive])
  @@index([userId, createdAt])
  @@index([habitId])
}

/**
 * One scheduled study session on one day.
 * A session is either a one-off (`seriesId` null) or an occurrence of a series.
 * Both are rows, because both need the same treatment downstream: a status, a
 * place in the week, a link to a habit, and the ability to be started against
 * the focus timer.
 * `durationMinutes` is stored rather than an end time. The end of a session is
 * a consequence of its start and its length, and storing it separately would
 * allow the two to disagree - a session that claims to run for an hour and
 * ends before it starts.
 */
model StudySession {
  id     String @id @default(cuid())
  userId String

  seriesId String?

  title   String
  subject String
  notes   String?
  color   String  @default("#C8F751")

  /**
   * The calendar day, as `@db.Date` (UTC midnight).
   */
  date            DateTime @db.Date
  startMinutes    Int
  durationMinutes Int

  status StudySessionStatus @default(PLANNED)

  /**
   * Minutes actually focused against this session.
   * Always zero until a focus timer is attached and finished. Scheduled time is
   * never copied into this column: "I planned 60 minutes and did 35" has to stay
   * two different numbers, or the difference between a plan and an achievement
   * stops existing.
   */
  actualMinutes Int @default(0)

  reminderLeadMinutes Int?

  habitId    String?
  categoryId String?

  /**
   * True when this occurrence was edited on its own, away from its series.
   * A series edit rewrites the future occurrences it owns, but must not clobber
   * a day the user deliberately changed. This flag is what makes "edit this
   * session" and "edit the whole series" different operations on the same data.
   */
  isException Boolean @default(false)

  startedAt   DateTime?
  completedAt DateTime?

  /**
   * On a rescheduled copy, the day it was moved from. This is the link between
   * the terminal `RESCHEDULED` original and its replacement, and it is what lets
   * the week say "moved here from Tuesday" without deleting the original's
   * history.
   */
  rescheduledFromDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  series        StudySeries?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  habit         Habit?         @relation(fields: [habitId], references: [id], onDelete: SetNull)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  focusSessions FocusSession[]
  habitLogs     HabitLog[]

  /**
   * One occurrence per series per day.
   * Postgres treats NULLs as distinct, so the rows with no series - the
   * one-off sessions - are not constrained by this at all, which is exactly
   * right: two one-off sessions on the same day are two sessions, not a
   * duplicate. For series-owned rows the constraint is the database-level
   * guarantee that generation can never write the same day twice.
   */
  @@unique([seriesId, date])
  @@index([userId, date])
  @@index([userId, status])
  @@index([seriesId])
  @@index([habitId])
}

/**
 * A day on a series that must never get a session again.
 * Deleting one occurrence of a recurring series cannot simply delete the row,
 * because the next generation pass would put it straight back - the user would
 * delete the same Tuesday for ever. This is the tombstone that says "not on this
 * day", and it is checked before a session is created.
 * Separate from the session table on purpose: a tombstone outlives the row it
 * replaced, and folding the two together would mean the row had to be kept
 * around just to remember that it is not supposed to exist.
 */
model StudySeriesSkip {
  id       String   @id @default(cuid())
  seriesId String
  date     DateTime @db.Date

  createdAt DateTime @default(now())

  series StudySeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, date])
  @@index([seriesId])
}

// ---------------------------------------------------------------------------
// Routines
// ---------------------------------------------------------------------------

model Routine {
  id          String      @id @default(cuid())
  userId      String
  name        String
  description String?
  kind        RoutineKind @default(CUSTOM)
  timeOfDay   Int? // minutes from midnight
  color       String      @default("#4ECDC4")
  icon        String      @default("repeat")
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      RoutineItem[]
  runs       RoutineRun[]
  timeBlocks TimeBlock[]

  @@index([userId, isActive])
}

model RoutineItem {
  id               String  @id @default(cuid())
  routineId        String
  title            String
  sortOrder        Int     @default(0)
  estimatedMinutes Int?
  categoryId       String?
  habitId          String? // completing this item can log the linked habit
  taskId           String? // running this item can create/attach the linked task
  // Whether running this step should give the user a task for it. Separate from
  // `taskId` because `taskId` records *which* task once one exists, and a step
  // that has never been run has no task to point at yet.
  createsTask      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routine  Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  habit    Habit?    @relation(fields: [habitId], references: [id], onDelete: SetNull)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([routineId, sortOrder])
  @@index([taskId])
}

model RoutineRun {
  id             String    @id @default(cuid())
  userId         String
  routineId      String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  completedItems Int       @default(0)
  totalItems     Int       @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([routineId, startedAt])
}

// ---------------------------------------------------------------------------
// Time blocks + focus
// ---------------------------------------------------------------------------

model TimeBlock {
  id     String @id @default(cuid())
  userId String

  date    DateTime    @db.Date
  title   String
  startAt DateTime
  endAt   DateTime
  source  BlockSource @default(MANUAL)
  color   String      @default("#C8F751")
  notes   String?
  locked  Boolean     @default(false) // AI planner must not move locked blocks

  taskId          String?
  habitId         String?
  routineId       String?
  calendarEventId String?
  workoutId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  habit         Habit?         @relation(fields: [habitId], references: [id], onDelete: Cascade)
  routine       Routine?       @relation(fields: [routineId], references: [id], onDelete: SetNull)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  workout       Workout?       @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, startAt, endAt])
}

model FocusSession {
  id     String @id @default(cuid())
  userId String

  taskId         String?
  projectId      String? // project the session was worked on, when it is not task-level
  startedAt      DateTime
  endedAt        DateTime?
  plannedSeconds Int
  actualSeconds  Int       @default(0)
  type           FocusType @default(POMODORO)
  rating         Int? // 1-5 self-reported productivity
  notes          String?
  endedEarly     Boolean   @default(false)
  xpAwarded      Int       @default(0)

  /**
   * The scheduled study session this timer is running against, if any.
   * This is what makes "Start Studying" on a timetable entry more than a
   * button that opens a timer: the focus session carries the subject and the
   * planned length, and finishing it writes the *actual* minutes back to the
   * study session. A timer started from the Focus page has no study session and
   * behaves exactly as it always did.
   */
  studySessionId String?

  /**
   * When the timer was paused, and how much time it has spent paused.
   * Elapsed focus time is derived from server-stamped instants, never from a
   * client-side counter, so a pause has to be recorded on the server too -
   * otherwise a paused timer would keep accruing focus time while the user
   * was away from the desk, and the study session would report minutes that
   * were never spent studying.
   * `pausedSeconds` accumulates the time already excluded, and `pausedAt` is
   * the instant the current pause began. A session that was never paused has
   * both at their defaults, so the arithmetic for every existing session is
   * unchanged.
   */
  pausedAt      DateTime?
  pausedSeconds Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  studySession StudySession? @relation(fields: [studySessionId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([userId, endedAt])
  @@index([taskId])
  @@index([projectId])
  @@index([studySessionId])
}

// ---------------------------------------------------------------------------
// Journal + wellbeing
// ---------------------------------------------------------------------------

model JournalEntry {
  id     String @id @default(cuid())
  userId String

  date      DateTime @db.Date
  title     String?
  content   String
  mood      Int? // 1-5
  energy    Int? // 1-5
  tags      String[] @default([])
  aiSummary String?
  wordCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, createdAt])
}

model MoodEnergyEntry {
  id     String @id @default(cuid())
  userId String

  date         DateTime @db.Date
  mood         Int // 1-5
  energy       Int // 1-5
  stress       Int // 1-5
  sleepQuality Int // 1-5
  sleepHours   Float?
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ---------------------------------------------------------------------------
// Insights + reports
// ---------------------------------------------------------------------------

model Insight {
  id     String @id @default(cuid())
  userId String

  kind          InsightKind
  status        InsightStatus @default(NEW)
  title         String
  body          String
  confidence    Float         @default(0)
  sampleSize    Int           @default(0)
  evidence      Json?
  source        AISource      @default(LOCAL)
  model         String?
  actionKind    String? // apply handler hint, e.g. RESCHEDULE_TASK
  actionPayload Json?
  validUntil    DateTime?
  actedAt       DateTime?

  relatedHabitId    String?
  relatedCategoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([userId, kind])
}

model WeeklyReview {
  id     String @id @default(cuid())
  userId String

  weekStart   DateTime @db.Date
  weekEnd     DateTime @db.Date
  periodLabel String

  summary         String
  metrics         Json
  highlights      Json
  misses          Json
  patterns        Json
  recommendations Json
  narrative       String?
  provider        String?
  model           String?

  /**
   * The user's own three answers to their week, written by hand.
   * They live here rather than on `WeeklyPlan` for one reason: a week is the unit
   * of reflection, not a plan. Someone with a fitness plan and a study plan has
   * one week that went well and one week that did not - two reviews would make
   * "how was my week" unanswerable, which is the `@@unique([userId, weekStart])`
   * constraint on this table saying out loud.
   * Nullable, and left null by the generator. `buildWeeklyReport` produces
   * `summary`/`metrics`/`highlights`; it cannot know what the user felt, and a
   * generated review presented in these fields would be inventing a subjective
   * answer to a question only the user can answer.
   */
  wentWell      String?
  shouldImprove String?
  nextWeekFocus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model MonthlyReport {
  id     String @id @default(cuid())
  userId String

  monthStart DateTime @db.Date
  monthEnd   DateTime @db.Date
  monthLabel String

  summary         String
  metrics         Json
  achievements    Json
  habitStats      Json
  goalStats       Json
  focusStats      Json
  timeStats       Json
  lifeBalance     Json
  missed          Json
  recommendations Json
  narrative       String?
  provider        String?
  model           String?
  pdfGeneratedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthStart])
  @@index([userId, monthStart])
}

// ---------------------------------------------------------------------------
// AI
// ---------------------------------------------------------------------------

model AIConversation {
  id     String @id @default(cuid())
  userId String

  title    String?
  provider String  @default("local")
  model    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String  @id @default(cuid())
  userId         String
  conversationId String?

  role      MessageRole
  content   String
  source    AISource    @default(LOCAL)
  provider  String?
  model     String?
  tokensIn  Int?
  tokensOut Int?
  latencyMs Int?
  errorCode String?

  createdAt DateTime @default(now())

  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

model UserStats {
  id     String @id @default(cuid())
  userId String @unique

  xp               Int       @default(0)
  level            Int       @default(1)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  freezeTokens     Int       @default(0)
  lastActivityDate DateTime? @db.Date
  tasksCompleted   Int       @default(0)
  habitsCompleted  Int       @default(0)
  focusMinutes     Int       @default(0)
  goalsAchieved    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  description String
  icon        String            @default("award")
  category    String            @default("general")
  rarity      AchievementRarity @default(COMMON)
  xpReward    Int               @default(50)
  criteria    Json
  sortOrder   Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserAchievement[]
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  progress      Float     @default(0)
  unlockedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

// ---------------------------------------------------------------------------
// Notifications + reminders
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(cuid())
  userId String

  type      NotificationType
  title     String
  body      String?
  actionUrl String?
  metadata  Json?
  readAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Reminder {
  id     String @id @default(cuid())
  userId String

  type         ReminderTargetType
  channel      ReminderChannel    @default(IN_APP)
  title        String
  body         String?
  scheduledFor DateTime
  timezone     String             @default("UTC")
  recurrence   Json?
  enabled      Boolean            @default(true)
  sentAt       DateTime?
  lastSentAt   DateTime?

  targetType ReminderTargetType?
  targetId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledFor, enabled])
}

// ---------------------------------------------------------------------------
// Calendar
// ---------------------------------------------------------------------------

model CalendarEvent {
  id     String @id @default(cuid())
  userId String

  title        String
  description  String?
  startAt      DateTime
  endAt        DateTime
  allDay       Boolean        @default(false)
  location     String?
  color        String         @default("#5BA8FF")
  source       CalendarSource @default(LOCAL)
  externalId   String?
  rrule        String?
  connectionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection CalendarConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  timeBlocks TimeBlock[]

  @@index([userId, startAt, endAt])
  @@index([connectionId, externalId])
}

model CalendarConnection {
  id     String @id @default(cuid())
  userId String

  provider        String
  email           String?
  // OAuth tokens are stored encrypted at rest with a server-side key.
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  scopes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events CalendarEvent[]

  @@index([userId, provider])
}

// ---------------------------------------------------------------------------
// Fitness - exercise library + workout log
// ---------------------------------------------------------------------------

/**
 * An entry in the exercise library.
 * `userId` is nullable and paired with `isSystem`, matching the `Category`
 * pattern: a null owner marks a read-only exercise shipped with the app, so
 * every user gets a usable library on day one without seeding per-user rows.
 * The uniqueness constraint is per-owner, and Postgres treats NULLs as
 * distinct, so system rows are not deduplicated against each other by the
 * database - the seed is responsible for not inserting the same system
 * exercise twice.
 */
model Exercise {
  id       String  @id @default(cuid())
  userId   String?
  isSystem Boolean @default(false)

  name        String
  muscleGroup MuscleGroup @default(OTHER)
  equipment   String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]
  routineExercises WorkoutRoutineExercise[]

  @@unique([userId, name])
  @@index([userId, muscleGroup])
  @@index([isSystem])
}

/**
 * A single training session.
 * `status` separates intent from fact. A PLANNED workout is a target for a
 * future day (optionally linked to a planner `TimeBlock`); a COMPLETED one is
 * history. All progress, volume and streak aggregates filter to COMPLETED, so
 * scheduling a session never inflates what the user has actually done.
 * `date` is a calendar day (`@db.Date`), not an instant, because a workout
 * belongs to a day rather than a moment. `startAt` carries the optional time
 * of day and `minutes` a manual duration, since a workout logged after the
 * fact may not have a reliable start/end pair.
 */
model Workout {
  id     String @id @default(cuid())
  userId String

  name        String
  date        DateTime      @db.Date
  startAt     DateTime?
  minutes     Int?
  notes       String?
  status      WorkoutStatus @default(COMPLETED)
  completedAt DateTime?

  /**
   * When an IN_PROGRESS session was started. Null for everything else, because a
   * completed session logged after the fact has no reliable start moment and
   * inventing one (`completedAt` minus `minutes`) would be a guess stored as a
   * fact.
   */
  startedAt DateTime?

  /**
   * Target muscle groups for a session, as free-form labels rather than the
   * `MuscleGroup` enum.
   * The enum is the right shape for the *library* — one exercise, one primary
   * group. A scheduled day is not: "Chest + Triceps" and "Abs" are what a person
   * writes on a plan, and mapping those onto a fixed enum would either lose the
   * distinction (Triceps and Biceps both collapse to ARMS) or force a taxonomy
   * the user did not choose. So a day's groups are strings, and the library's
   * enum stays where it belongs.
   */
  muscleGroups String[] @default([])

  categoryId String?
  goalId     String?

  /**
   * Optional habit this workout contributes to. See `HabitLog.workoutId` for the
   * double-count rule that makes this safe.
   */
  habitId String?

  /**
   * Provenance for a session materialised from a recurring routine. Both are
   * SetNull, so deleting a routine keeps every session it generated — history is
   * a record of what happened, not an extension of the template that proposed it.
   */
  routineId    String?
  routineDayId String?

  /**
   * On a rescheduled copy, the date of the slot it was moved from. This is the
   * link between the terminal RESCHEDULED original and the PLANNED replacement,
   * and it is what lets the week show "moved here from Tuesday".
   */
  rescheduledFromDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goal       Goal?              @relation(fields: [goalId], references: [id], onDelete: SetNull)
  habit      Habit?             @relation(fields: [habitId], references: [id], onDelete: SetNull)
  routine    WorkoutRoutine?    @relation(fields: [routineId], references: [id], onDelete: SetNull)
  routineDay WorkoutRoutineDay? @relation(fields: [routineDayId], references: [id], onDelete: SetNull)
  exercises  WorkoutExercise[]
  timeBlocks TimeBlock[]
  habitLogs  HabitLog[]

  @@index([userId, date])
  @@index([userId, status])
  @@index([userId, date, status])
  @@index([categoryId])
  @@index([goalId])
  @@index([routineId])
  @@index([routineDayId])
}

/**
 * One exercise within a workout.
 * `name` is a denormalised snapshot copied from the library at the time the
 * exercise is added, and `exerciseId` is only a soft link. A personal best is
 * tracked against the snapshot name so that editing or deleting a library
 * exercise never rewrites (or erases) the history that referenced it.
 */
model WorkoutExercise {
  id         String  @id @default(cuid())
  workoutId  String
  exerciseId String?
  name       String
  position   Int     @default(0)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets     WorkoutSet[]

  @@index([workoutId, position])
  @@index([exerciseId])
}

/**
 * One set of an exercise.
 * Strength sets are described by `reps` and `weight`; timed sets (planks,
 * cardio intervals) by `durationSeconds`. All are optional so both kinds can
 * share a table without inventing sentinel values, and `completed` lets a user
 * log a set they did not finish (a failed rep) without deleting the plan.
 */
model WorkoutSet {
  id                String  @id @default(cuid())
  workoutExerciseId String
  position          Int     @default(0)
  reps              Int?
  weight            Float?
  durationSeconds   Int?
  restSeconds       Int?
  completed         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId, position])
}

// ---------------------------------------------------------------------------
// Fitness - recurring weekly workout routines (the weekly planner's template)
// ---------------------------------------------------------------------------

/**
 * A named, recurring weekly training split: Push/Pull/Legs, Upper/Lower, a
 * five-day bro split.
 * This is deliberately NOT the existing `Routine` model. That one is a *sequence
 * of steps to run through in one sitting* (a morning routine, a study routine)
 * and its `kind` merely tags what it is about; a training week is a different
 * structure entirely — seven weekdays, some of which are rest days, each
 * carrying a set of exercises. Reusing `Routine` would mean a table whose
 * meaning depends on its `kind`, which is exactly the kind of conditional schema
 * this codebase avoids.
 * A routine is a *template*. It never stores the sessions the user actually did;
 * those are `Workout` rows, and deleting a routine must not delete them. The
 * planner materialises the template into concrete `Workout` rows over a rolling
 * horizon, so editing a day to add a real exercise set writes to the session, and
 * editing the template only affects sessions not yet generated.
 */
model WorkoutRoutine {
  id     String @id @default(cuid())
  userId String

  name        String
  description String?
  color       String  @default("#C8F751")

  /**
   * Whether this routine is the one driving the schedule right now. At most one
   * routine per user is active, enforced in the service layer when a routine is
   * activated (activating one pauses the rest) rather than by a partial unique
   * index, so the invariant lives beside the write that must maintain it.
   */
  isActive    Boolean   @default(false)
  activatedAt DateTime?
  pausedAt    DateTime?

  /**
   * The last calendar day the routine has been materialised through.
   * This is the frontier the lazy generator extends up to, and it is why a
   * session the user deliberately deleted does not silently reappear on the next
   * page load: generation only ever fills days *after* this marker, never days
   * behind it. `null` means nothing has been generated yet. Activating or
   * re-applying a routine rewinds it to today, because those actions replace the
   * whole future schedule by design.
   */
  generatedThrough DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  days     WorkoutRoutineDay[]
  workouts Workout[]

  @@index([userId, isActive])
  @@index([userId, createdAt])
}

/**
 * One weekday of a routine.
 * `weekday` is 0 = Monday .. 6 = Sunday, matching the Monday-first week the
 * planner UI shows. This differs from `WeeklyPlanDay.dayOfWeek` and
 * `HabitSchedule.dayOfWeek`, which follow JS `Date.getDay()` (0 = Sunday); the
 * divergence is deliberate and local to this table. A training week is
 * conventionally read Monday-first, and converting at the two boundaries (the
 * generator and the serialiser) is cheaper than making every reader of this
 * column remember an offset.
 * A day is either a training day (exercises, target minutes) or a rest day. Rest
 * is stored explicitly rather than inferred from "no exercises" for the same
 * reason `WeeklyPlanDay` exists: "Wednesday is rest" and "I have not filled
 * Wednesday in" are different claims.
 */
model WorkoutRoutineDay {
  id            String   @id @default(cuid())
  routineId     String
  weekday       Int // 0 = Monday .. 6 = Sunday
  name          String
  muscleGroups  String[] @default([])
  isRest        Boolean  @default(false)
  targetMinutes Int?
  /**
   * Optional default start time, minutes from local midnight.
   */
  startMinutes  Int?
  notes         String?
  position      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routine   WorkoutRoutine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises WorkoutRoutineExercise[]
  workouts  Workout[]

  @@unique([routineId, weekday])
  @@index([routineId])
}

/**
 * One exercise within a routine day.
 * Mirrors `WorkoutExercise`: `name` is the durable snapshot and `exerciseId` a
 * soft link to the library, so editing or deleting a library exercise never
 * rewrites the template.
 */
model WorkoutRoutineExercise {
  id           String  @id @default(cuid())
  routineDayId String
  exerciseId   String?
  name         String
  position     Int     @default(0)
  restSeconds  Int?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routineDay WorkoutRoutineDay   @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exercise   Exercise?           @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets       WorkoutRoutineSet[]

  @@index([routineDayId, position])
  @@index([exerciseId])
}

/**
 * One planned set within a routine exercise. Same shape as `WorkoutSet`.
 */
model WorkoutRoutineSet {
  id                String @id @default(cuid())
  routineExerciseId String
  position          Int    @default(0)
  reps              Int?
  weight            Float?
  durationSeconds   Int?
  restSeconds       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routineExercise WorkoutRoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)

  @@index([routineExerciseId, position])
}
